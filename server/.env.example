# Leave everything unset to run the deterministic local engine (no keys needed).

# --- optional: use a real model (OpenAI-compatible endpoint) ---
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- demo timing ---
TOKEN_DELAY_MS=22          # slow enough that a human can barge in mid-sentence
RETRIEVAL_LATENCY_MS=260   # the latency speculation is trying to hide
PLAN_STEP_MS=90

# --- behaviour toggles ---
SPECULATION=true
STRICT_HARNESS=true
MAX_TOOL_CALLS=4
TOOL_TIMEOUT_MS=4000
